{
  "name": "daymap-connector",
  "version": "0.4.0",
  "description": "MCP server (Claude connector) for the Daymap school family portal",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "test": "node --import tsx --test test/*.test.ts",
    "bundle": "esbuild src/http.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johngrimes/daymap-connector.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johngrimes/daymap-connector/issues"
  },
  "homepage": "https://github.com/johngrimes/daymap-connector#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.1.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "tough-cookie": "^6.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.5",
    "domhandler": "^5.0.3",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
